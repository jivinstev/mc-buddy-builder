{
  "outputStyle": "Buddy Builder",
  "spinnerTipsEnabled": false,
  "showTurnDuration": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Building",
      "Crafting",
      "Mining",
      "Tinkering",
      "Hammering",
      "Imagining",
      "Sketching",
      "Testing"
    ]
  },
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(./gradlew:*)",
      "Bash(./setup:*)",
      "Bash(./tools/gate-b.sh:*)",
      "Bash(./tools/client-test.sh:*)",
      "Bash(MC=1.21.1 ./tools/gate-b.sh:*)",
      "Bash(MC=26.2 ./tools/gate-b.sh:*)",
      "Bash(MC=1.21.1 ./tools/client-test.sh:*)",
      "Bash(MC=26.2 ./tools/client-test.sh:*)",
      "Bash(python3 tools/buddy/rename_mod.py:*)",
      "Bash(python3 tools/buddy/test_rename_mod.py:*)",
      "Bash(python3 tools/buddy/test_setup.py:*)",
      "Bash(python3 tools/buddy/test_name_guard.py:*)",
      "Bash(python3 tools/buddy/test_permissions.py:*)",
      "Bash(python3 tools/buddy/make_texture.py:*)",
      "Bash(python3 tools/buddy/test_make_texture.py:*)",
      "Bash(python3 tools/check-private-terms.py:*)",
      "Bash(python3 cloud/check.py:*)",
      "Bash(python3 cloud/check_readme.py:*)",
      "Bash(bash cloud/ensure.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(unzip -l:*)"
    ],
    "ask": [
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git stash:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(sudo:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/cloud/session_start.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/name_guard.py\""
          }
        ]
      }
    ]
  }
}
